# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend Server URL (optional, defaults to NEXT_PUBLIC_API_URL host)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Frontend App URL (for tracking and links, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Publishable Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# SMTP (Nodemailer) — powers the "Email me a preview" dispatch.
# Local dev falls back to backend/.env automatically when these are unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=app-password
EMAIL_FROM="InviteHub <no-reply@example.com>"
